/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https: wss: http://localhost:8787 ws://localhost:8787; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/app/*
  Cache-Control: public, max-age=0, must-revalidate
/processor/*
  Cache-Control: public, max-age=0, must-revalidate
/config.json
  Cache-Control: no-store
/processor-worker.js
  Cache-Control: no-cache
